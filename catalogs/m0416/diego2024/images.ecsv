# %ECSV 1.0
# ---
# datatype:
# - name: recno
#   datatype: int32
#   description: Record number assigned by the VizieR team. Should Not be used for identification.
#   meta: !!omap
#   - {ucd: meta.record}
#   - {width: 8}
#   - links:
#     - {href: 'http://vizier.cfa.harvard.edu/viz-bin/VizieR-5?-info=XML&-out.add=.&-source=J/A+A/690/A114/tableb1&recno=${recno}'}
# - name: Arc
#   datatype: string
#   description: Arc ID (NNN.a)
#   meta: !!omap
#   - {ucd: meta.id;meta.main}
#   - {_votable_string_dtype: char}
# - name: RAJ2000
#   unit: deg
#   datatype: float64
#   format: '{:10.6f}'
#   description: Arc Right ascension (J2000)
#   meta: !!omap
#   - {ucd: pos.eq.ra;meta.main}
#   - {width: 10}
#   - {precision: '6'}
# - name: DEJ2000
#   unit: deg
#   datatype: float64
#   format: '{:10.6f}'
#   description: Arc declination (J2000)
#   meta: !!omap
#   - {ucd: pos.eq.dec;meta.main}
#   - {width: 10}
#   - {precision: '6'}
# - name: zsp
#   datatype: float32
#   format: '{:7.4f}'
#   description: '? Arc spectroscopic redshift'
#   meta: !!omap
#   - {ucd: src.redshift}
#   - {width: 7}
#   - {precision: '4'}
#   - values: {'null': .nan}
# - {name: zsp.mask, datatype: bool}
# - name: zgeom
#   datatype: float32
#   format: '{:6.3f}'
#   description: '? Arc geometric redshift'
#   meta: !!omap
#   - {ucd: stat.param}
#   - {width: 6}
#   - {precision: '3'}
#   - values: {'null': .nan}
# - {name: zgeom.mask, datatype: bool}
# - name: e_zgeom
#   datatype: float32
#   format: '{:6.3f}'
#   description: '? Error in geometric redshift of the arc'
#   meta: !!omap
#   - {ucd: stat.error}
#   - {width: 6}
#   - {precision: '3'}
#   - values: {'null': .nan}
# - {name: e_zgeom.mask, datatype: bool}
# - name: zph
#   datatype: float32
#   format: '{:5.2f}'
#   description: '? Arc photometric redshift'
#   meta: !!omap
#   - {ucd: src.redshift}
#   - {width: 5}
#   - {precision: '2'}
#   - values: {'null': .nan}
# - {name: zph.mask, datatype: bool}
# - name: mu
#   datatype: float32
#   format: '{:4.1f}'
#   description: '? Arc magnification'
#   meta: !!omap
#   - {ucd: phot.flux;arith.ratio}
#   - {width: 4}
#   - {precision: '1'}
#   - values: {'null': .nan}
# - {name: mu.mask, datatype: bool}
# - name: dTime
#   unit: yr
#   datatype: float32
#   format: '{:5.2f}'
#   description: Arc time delay with respect to image arriving first
#   meta: !!omap
#   - {ucd: time;arith.diff}
#   - {width: 5}
#   - {precision: '2'}
# - name: Rank
#   datatype: string
#   description: Arc Rank
#   meta: !!omap
#   - {ucd: meta.code}
#   - {_votable_string_dtype: char}
# meta: !!omap
# - {ID: J_A_A_690_A114_tableb1}
