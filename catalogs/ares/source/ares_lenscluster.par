# Generated by scripts/build_ff_sims_lenscluster_inputs.py
# cluster_key ares
# source FF-SIMS Ares
# Data-informed FF-SIMS Lenstool model: two smooth dPIE halos, member scaling, and optional external shear.
# Members are read from clgal_cat.txt; source catalog selection is F814W < 24.00.
# Galaxy scaling uses F160W luminosities with mag0=18.50, sigma*=100.000 km/s, rcut*=270.000 kpc.

runmode
    reference 3 0.00000000 0.00000000
    end
grille
    nombre 128
    polaire 0
    end
image
    multfile 1 ares_obs_arcs.cat
    forme -2
    mult_wcs 1
    sigposArcsec 0.50000000
    end
# O1 is the first smooth dPIE clump, anchored on clgal_cat.txt member 2.
potentiel O1
    profil 81
    x_centre 20.00000000
    y_centre -32.00000000
    ellipticite 0.30000000
    angle_pos 0.00000000
    core_radius 20.00000000
    cut_radius_kpc 1500.00000000
    v_disp 950.00000000
    z_lens 0.50000000
    end
limit O1
    x_centre 1 15.00000000 25.00000000 0.10000000
    y_centre 1 -37.00000000 -27.00000000 0.10000000
    ellipticite 1 0.00000000 0.50000000 0.02000000
    angle_pos 1 -180.00000000 180.00000000 0.50000000
    core_radius 1 5.00000000 60.00000000 0.10000000
    v_disp 9 950.00000000 250.00000000 500.00000000 1800.00000000
    end
# O2 is the second smooth dPIE clump, anchored on clgal_cat.txt member 3.
potentiel O2
    profil 81
    x_centre -40.00000000
    y_centre 40.00000000
    ellipticite 0.30000000
    angle_pos 0.00000000
    core_radius 20.00000000
    cut_radius_kpc 1500.00000000
    v_disp 950.00000000
    z_lens 0.50000000
    end
limit O2
    x_centre 1 -45.00000000 -35.00000000 0.10000000
    y_centre 1 35.00000000 45.00000000 0.10000000
    ellipticite 1 0.00000000 0.50000000 0.02000000
    angle_pos 1 -180.00000000 180.00000000 0.50000000
    core_radius 1 5.00000000 45.00000000 0.10000000
    v_disp 9 950.00000000 175.00000000 600.00000000 1400.00000000
    end


potfile
    filein 3 ares_cluster_members_potfile.cat
    type 81
    mag0 18.50000000
    corekpc 0.15000000
    z_lens 0.50000000
    sigma 9 100.00000000 15.00000000 70.00000000 500.00000000
    cutkpc 9 270.00000000 35.00000000 160.00000000 800.00000000
    end
cosmologie
    H0 70.40000000
    omega 0.27200000
    lambda 0.72800000
    end
champ
    dmax 155
    end
fini
