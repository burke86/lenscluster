# Generated by scripts/build_ff_sims_lenscluster_inputs.py
# cluster_key hera
# source FF-SIMS Hera
# Data-informed FF-SIMS Lenstool model: two smooth dPIE halos, member scaling, and optional external shear.
# Members are read from clgal_cat.txt; source catalog selection is F814W < 24.00.
# Galaxy scaling uses F160W luminosities with mag0=19.82, sigma*=96.700 km/s, rcut*=33.000 kpc.

runmode
    reference 3 0.00000000 0.00000000
    end
grille
    nombre 128
    polaire 0
    end
image
    multfile 1 hera_obs_arcs.cat
    forme -2
    mult_wcs 1
    sigposArcsec 0.50000000
    end
# O1 is the first smooth dPIE clump, anchored on clgal_cat.txt member 1.
potentiel O1
    profil 81
    x_centre 19.54080009
    y_centre 2.37820005
    ellipticite 0.30000000
    angle_pos 30.00000000
    core_radius 8.00000000
    cut_radius_kpc 1500.00000000
    v_disp 800.00000000
    z_lens 0.50700000
    end
limit O1
    x_centre 1 14.54080009 24.54080009 0.10000000
    y_centre 1 -2.62179995 7.37820005 0.10000000
    ellipticite 1 0.00000000 0.80000000 0.02000000
    angle_pos 1 -180.00000000 180.00000000 0.50000000
    core_radius 1 2.00000000 15.00000000 0.10000000
    v_disp 9 800.00000000 280.00000000 100.00000000 2200.00000000
    end
# O2 is the second smooth dPIE clump, anchored on clgal_cat.txt member 2.
potentiel O2
    profil 81
    x_centre 0.00100000
    y_centre 0.00300000
    ellipticite 0.30000000
    angle_pos 24.00000000
    core_radius 5.00000000
    cut_radius_kpc 1500.00000000
    v_disp 700.00000000
    z_lens 0.50700000
    end
limit O2
    x_centre 1 -4.99900000 5.00100000 0.10000000
    y_centre 1 -4.99700000 5.00300000 0.10000000
    ellipticite 1 0.00000000 0.80000000 0.02000000
    angle_pos 1 -180.00000000 180.00000000 0.50000000
    core_radius 1 2.00000000 15.00000000 0.10000000
    v_disp 9 700.00000000 245.00000000 100.00000000 2200.00000000
    end


potfile
    filein 3 hera_cluster_members_potfile.cat
    type 81
    mag0 19.82000000
    corekpc 0.15000000
    z_lens 0.50700000
    sigma 9 96.70000000 40.00000000 30.00000000 250.00000000
    cutkpc 9 33.00000000 25.00000000 3.00000000 250.00000000
    end
cosmologie
    H0 72.00000000
    omega 0.24000000
    lambda 0.76000000
    end
champ
    dmax 156
    end
fini
